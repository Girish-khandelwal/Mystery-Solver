{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": { "@/*": ["../*"], "@/lib/client": ["./src/client.ts"] }
  },
  "include": ["src", "tests", "vite.config.ts", "capacitor.config.ts"]
}
